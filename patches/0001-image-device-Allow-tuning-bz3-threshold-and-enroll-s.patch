From 0172bf6cbdfe8548ef725b50bad14f85816df782 Mon Sep 17 00:00:00 2001
From: fingerprint-t400 <t400@localhost>
Date: Wed, 18 Nov 2026 14:56:54 +0000
Subject: [PATCH 1/2] image-device: Allow tuning bz3 threshold and enroll
 stages from the environment

Old swipe sensors (e.g. the UPEK TouchStrip in ThinkPad T400/T500/X200)
produce images with few minutiae, so genuine matches often score below
the driver threshold and verification always fails.

Read LIBFPRINT_BZ3_THRESHOLD (1-200) and LIBFPRINT_ENROLL_STAGES (1-20)
when an image device is opened, after the driver has set its defaults,
so users can tune matching without rebuilding the library.
---
 libfprint/fpi-image-device.c | 65 ++++++++++++++++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/libfprint/fpi-image-device.c b/libfprint/fpi-image-device.c
index 8184d3a..3ba33e9 100644
--- a/libfprint/fpi-image-device.c
+++ b/libfprint/fpi-image-device.c
@@ -687,6 +687,67 @@ fpi_image_device_deactivate_complete (FpImageDevice *self, GError *error)
   fp_image_device_maybe_complete_action (self, error);
 }
 
+/* Runtime tuning knobs for image (NBIS) based sensors.
+ *
+ * Old swipe sensors such as the UPEK TouchStrip found in ThinkPad T400/T500/
+ * X200 laptops produce small images with few minutiae, so the bozorth3 score
+ * of a genuine match is often below the driver's threshold ("verify-no-match"
+ * with the enrolled finger). These environment variables let the user tune
+ * the threshold and the number of enroll swipes without rebuilding:
+ *
+ *   LIBFPRINT_BZ3_THRESHOLD  bozorth3 score needed for a match (1-200)
+ *   LIBFPRINT_ENROLL_STAGES  number of swipes recorded on enrollment (1-20)
+ *
+ * Set them in the environment of the process using libfprint, e.g. with a
+ * systemd drop-in for fprintd.service.
+ */
+static gboolean
+get_env_tunable (const char *name, gint min, gint max, gint *out)
+{
+  const char *val = g_getenv (name);
+  gint64 parsed;
+
+  if (val == NULL || *val == '\0')
+    return FALSE;
+
+  if (!g_ascii_string_to_signed (val, 10, min, max, &parsed, NULL))
+    {
+      g_warning ("Ignoring invalid %s=\"%s\", it must be a number between %d and %d",
+                 name, val, min, max);
+      return FALSE;
+    }
+
+  *out = (gint) parsed;
+  return TRUE;
+}
+
+static void
+apply_env_tunables (FpImageDevice *self)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpDevice *device = FP_DEVICE (self);
+  gint value;
+
+  if (get_env_tunable ("LIBFPRINT_BZ3_THRESHOLD", 1, 200, &value))
+    {
+      g_message ("%s: bz3 threshold overridden by LIBFPRINT_BZ3_THRESHOLD: %d -> %d",
+                 fp_device_get_driver (device), priv->bz3_threshold, value);
+      priv->bz3_threshold = value;
+    }
+
+  if (get_env_tunable ("LIBFPRINT_ENROLL_STAGES", 1, 20, &value))
+    {
+      g_message ("%s: enroll stages overridden by LIBFPRINT_ENROLL_STAGES: %d -> %d",
+                 fp_device_get_driver (device),
+                 fp_device_get_nr_enroll_stages (device), value);
+      fpi_device_set_nr_enroll_stages (device, value);
+    }
+
+  fp_dbg ("%s: using bz3 threshold %d, %d enroll stages",
+          fp_device_get_driver (device), priv->bz3_threshold,
+          fp_device_get_nr_enroll_stages (device));
+}
+
 /**
  * fpi_image_device_open_complete:
  * @self: a #FpImageDevice imaging fingerprint device
@@ -712,6 +773,10 @@ fpi_image_device_open_complete (FpImageDevice *self, GError *error)
 
   fpi_device_report_finger_status (FP_DEVICE (self), FP_FINGER_STATUS_NONE);
 
+  /* After the driver's open, so the user setting wins over driver defaults. */
+  if (!error)
+    apply_env_tunables (self);
+
   fpi_device_open_complete (FP_DEVICE (self), error);
 }
 
